---
layout: layouts/base
---

{% set bgColors = ["bg-slate-100", "bg-slate-200", "bg-slate-300", "bg-slate-400", "bg-slate-500"] %}

<div class="swiper w-full h-screen !fixed top-0 left-0 -z-10">
    <div class="swiper-wrapper h-full">
        {% for field in fields %}
        <div class="swiper-slide !flex h-full items-center justify-center {{ bgColors[loop.index0 % 5] }}">
            <h1 class="fitty text-center px-8 pb-10" style="line-height:0.9">{{ field }}</h1>
        </div>
        {% endfor %}
        <div class="swiper-slide !flex h-full items-center justify-center {{ bgColors[loop.index0 % 5] }}">
            <a href="mailto:email@bingo.computer" class="fitty text-center px-8 pb-10" style="line-height:0.9">email@bingo.computer</a>
        </div>
    </div>
</div>
<script>
(function() {
    var colors = ['bg-slate-100','bg-slate-200','bg-slate-300','bg-slate-400','bg-slate-500'];
    document.querySelectorAll('.swiper-slide').forEach(function(slide) {
        colors.forEach(function(c) { slide.classList.remove(c); });
        slide.classList.add(colors[Math.floor(Math.random() * colors.length)]);
    });
})();
</script>

<div
    x-data="{ visible: false }"
    x-init="setTimeout(() => visible = true, 6000)"
    x-show="visible"
    x-transition:enter="transition duration-300"
    x-transition:enter-start="opacity-0 translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition duration-300"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 translate-y-2"
    class="fixed bottom-4 w-full flex justify-center z-10 pointer-events-none"
>
    <button
        @click="visible = false; document.getElementById('design').scrollIntoView({ behavior: 'smooth' })"
        class="pointer-events-auto px-6 py-3 text-lg"
    >
        {# <img src="{{ '/assets/images/bingo-computer-arrow.svg' | url }}" alt="Scroll down" class="w-8"> #}
        Info
    </button>
</div>

<div class="grid md:grid-cols-2 w-screen z-10 mt-[100svh] relative">
    <section id="design" class="bg-slate-300">
        <div class="w-full text-center bg-black pb-1 text-white sticky top-0 z-50">
            <h1 class="fitty text-center px-8" style="line-height:0.8">Branding & <br>Creative Direction</h1>
        </div>
        <div class="text-lg md:text-xl mb-20">
            <p class="">
                Design, production, and creative direction for brands and clients in the field of contemporary arts and culture.
            </p>
        </div>
        <div class="mb-20">
            <h2 class="fitty opacity-50 text-center" style="line-height:0.8">Expertise</h2>
            <p class="text-lg md:text-xl">
                Typography, Art Direction, Branding, Print Design, Photography, Illustration, Color Theory, Composition, Visual Identity, Brand Strategy, Packaging Design, Editorial Design, Copywriting, Creative Storytelling, Analog Photography, Traditional Media, Conceptual Thinking, Cultural Research, Design Thinking, Trend Analysis, ...
            </p>
        </div>
        <div class="mb-20">
            <h2 class="opacity-50 fitty text-center" style="line-height:0.8">Connect</h2>
            <p class="text-lg md:text-xl">
                Always <a href="#contact" class="text-green-500">open</a> for new challenges, project consultation, and in-depth engagement with creative projects. Don’t be a stranger!
            </p>
        </div>
    </section>
    <section id="development" class="bg-slate-100">
        {# <div class="h-20 bg-slate-50"></div> #}
        <div class="w-full text-center bg-black pb-4 sticky top-0 z-50">
            <h1 class="fitty text-center text-white px-8" style="line-height:0.8">Design &<br>Development</h1>
        </div>
        <div class="text-lg md:text-xl mb-20">
            <p class="">
                Design and development of tailored websites and digital systems that are useful, simple, and effortless to maintain.
            </p>
        </div>
        <div class="text-lg md:text-xl mb-20">
            <h2 class="opacity-50 fitty">Tech Stack</h2>
            <p class="">
                Kirby CMS, Typo3, Tailwind, SASS, vite, Adobe Suite, Serverless, DNS, Alpine JS, Shopify, PHP, Node.js, REST APIs, Vue, Webpack, Git, SEO, Accessibility, Performance Optimization, Responsive Design, UI/UX Design, CMS Development, Static Site Generators, CI/CD, Docker, Design Systems, Figma, Prototyping, Creative Coding, ...
            </p>
        </div>
        <div class="text-lg md:text-xl mb-20">
            <h2 class="opacity-50 fitty">Availability</h2>
            <p class="">
                Currently <a href="#contact" class="text-green-500">available</a> for new commissions, technical consultation, and development services for other designers and agencies. Reach out!
            </p>
        </div>
    </section>
</div>

<div class="bg-black text-white w-screen z-10 relative">
    <h2 class="fitty" style="line-height:1">Get in touch:</h2>
</div>

<section class="py-32 md:py-48 z-10 relative bg-white" id="contact">
  <div class="w-full text-center flex items-center justify-center">
    <a class="fitty" href="mailto:{{ site.email }}">{{site.email}}</a>
  </div>
</section>